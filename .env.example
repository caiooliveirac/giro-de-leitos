# Backend
DATABASE_URL=postgresql://giro:giro_seguro_2026@postgres:5432/giro_de_leitos
JWT_SECRET=change-me-to-a-long-random-string
CPF_ENCRYPTION_KEY=                # gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CPF_HASH_PEPPER=optional-pepper-for-cpf-hash
PUBLIC_BASE_URL=https://mnrs.com.br

# Admin inicial (rodar scripts/seed_admin.py uma vez)
ADMIN_INITIAL_EMAIL=admin@exemplo.com
ADMIN_INITIAL_PASSWORD=troqueIsso!
ADMIN_INITIAL_NAME=Admin Regulador
ADMIN_INITIAL_CPF=00000000000
ADMIN_INITIAL_PIN=0000

# Integrações existentes
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Chats extras liberados para os relatórios de gestão (/vagas, /cobranca,
# /lotacao, /naoparseados). Lista separada por vírgula; o TELEGRAM_ADMIN_CHAT_ID
# já é autorizado por padrão. Vazio = só o admin.
TELEGRAM_REPORT_CHAT_IDS=
# Fuso usado em todo horário exibido pelo bot (default America/Sao_Paulo)
REPORT_TIMEZONE=America/Sao_Paulo
WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:3000
WHATSAPP_GROUP_IDS=
WHATSAPP_PHONE_NUMBER=

# Alerta curto de UPA sem giro no WhatsApp do gestor (canal ADICIONAL ao
# watcher do Telegram; ver services/whatsapp_alerts.py). Nasce DESLIGADO:
# com enabled=false ou destino vazio o código só loga o que enviaria.
WHATSAPP_ALERT_ENABLED=false
# Destino único: número com DDI (5571999999999) ou JID completo.
WHATSAPP_ALERT_TO=
# Gateway whatsmeow. Da API (em container) use host.docker.internal;
# 127.0.0.1:3080 só funciona para processos do host.
WHATSAPP_GW_URL=http://host.docker.internal:3080
# Basic auth do gateway, "usuario:segredo" (= APP_BASIC_AUTH do whatsmeow-gw)
WHATSAPP_GW_AUTH=
# Limiar PRÓPRIO, separado do STALE_ALERT_HOURS (10h) do Telegram
WHATSAPP_ALERT_HOURS=12
# Janela mínima entre dois avisos sobre a MESMA unidade
WHATSAPP_ALERT_COOLDOWN_HOURS=6

# E-mail (SMTP) — usado pelo "esqueci minha senha" (services/email.py)
# Use uma "senha de app" do Google (NÃO a senha normal da conta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=          # e-mail da conta Google que envia (ex.: giro@suaempresa.com)
SMTP_PASS=          # senha de app gerada no Google
SMTP_FROM=          # opcional; default = SMTP_USER

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
